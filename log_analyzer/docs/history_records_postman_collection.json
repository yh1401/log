{
  "info": {
    "_postman_id": "history-records-api-collection",
    "name": "历史记录接口 - 管理员认证",
    "description": "Log Analyzer 历史记录模块 API 接口集合，所有接口仅管理员用户 useradmin 可访问",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variables": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "admin_user_id",
      "value": "admin001",
      "type": "string"
    },
    {
      "key": "admin_username",
      "value": "useradmin",
      "type": "string"
    },
    {
      "key": "normal_user_id",
      "value": "user001",
      "type": "string"
    },
    {
      "key": "normal_username",
      "value": "normaluser",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "=== 认证测试 ===",
      "item": [
        {
          "name": "[成功] 管理员访问历史报告列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{admin_user_id}}",
                "type": "text"
              },
              {
                "key": "X-Username",
                "value": "{{admin_username}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/history/reports",
              "host": ["{{base_url}}"],
              "path": ["api", "history", "reports"]
            }
          },
          "response": [
            {
              "name": "成功响应",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"code\": 0,\n  \"message\": \"获取成功\",\n  \"data\": {\n    \"reports\": [],\n    \"total\": 0,\n    \"limit\": 100,\n    \"offset\": 0\n  }\n}"
            }
          ]
        },
        {
          "name": "[失败] 非管理员访问历史报告列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{normal_user_id}}",
                "type": "text"
              },
              {
                "key": "X-Username",
                "value": "{{normal_username}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/history/reports",
              "host": ["{{base_url}}"],
              "path": ["api", "history", "reports"]
            }
          },
          "response": [
            {
              "name": "拒绝访问响应",
              "originalRequest": {},
              "status": "Forbidden",
              "code": 403,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"code\": 403,\n  \"message\": \"用户 normaluser 不是管理员，无权访问此接口\",\n  \"data\": null\n}"
            }
          ]
        },
        {
          "name": "[失败] 未提供用户标识",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/history/reports",
              "host": ["{{base_url}}"],
              "path": ["api", "history", "reports"]
            }
          },
          "response": [
            {
              "name": "未授权响应",
              "originalRequest": {},
              "status": "Forbidden",
              "code": 403,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"code\": 403,\n  \"message\": \"未提供用户标识\",\n  \"data\": null\n}"
            }
          ]
        }
      ]
    },
    {
