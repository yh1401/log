        {
          "name": "创建历史报告",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{admin_user_id}}",
                "type": "text"
              },
              {
                "key": "X-Username",
                "value": "{{admin_username}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/history/reports",
              "host": ["{{base_url}}"],
              "path": ["api", "history", "reports"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"系统异常分析报告\",\n  \"file_name\": \"error.log\",\n  \"file_type\": \"log\",\n  \"summary\": \"分析了系统错误日志\",\n  \"statistics\": {\"error_count\": 10, \"warning_count\": 25},\n  \"analysis\": {},\n  \"files\": [],\n  \"tags\": [\"error\", \"analysis\"],\n  \"metadata\": {}\n}"
            }
          },
          "response": [
            {
              "name": "成功响应",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"code\": 0,\n  \"message\": \"创建成功\",\n  \"data\": {\n    \"report_id\": \"rpt_20260602_xxx\"\n  }\n}"
            }
          ]
